HOST=0.0.0.0
PORT=3000
# Ongale injects DATABASE_URL when PostgreSQL is bound. Use it unchanged.
# Local compose database only (not a production credential):
DATABASE_URL=postgresql://remote:local-development-only@127.0.0.1:5433/mac_remote
ALLOW_REGISTRATION=true
# Optional explicit public origin if your proxy rewrites Host; no trailing path.
# PUBLIC_URL=https://your-app.ongale.dev
# Optional extra cross-origin clients; omit to keep the native/local defaults.
# ALLOWED_ORIGINS=app://macremote,capacitor://localhost,http://localhost,http://127.0.0.1:5173,http://localhost:5173
# Optional coturn REST credentials. Use a TLS reverse proxy outside localhost.
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
# TURN_SECRET=replace-with-your-coturn-static-auth-secret
# STUN_URL=stun:stun.example.com:3478
